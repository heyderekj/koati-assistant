{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "^mcp__.*[Kk]oati.*__get_handoff$",
                "hooks": [
                    {
                        "type": "mcp_tool",
                        "server": "plugin:koati:koati",
                        "tool": "report_activity",
                        "timeout": 5,
                        "input": {
                            "session": "${session_id}",
                            "event": "PostToolUse",
                            "runs_in": "claude_code",
                            "card_id": "${tool_input.id}"
                        }
                    }
                ]
            },
            {
                "matcher": "^mcp__.*[Kk]oati.*__(report_progress|ask_person|attach_artifact|upload_build|add_card_note)$",
                "hooks": [
                    {
                        "type": "mcp_tool",
                        "server": "plugin:koati:koati",
                        "tool": "report_activity",
                        "timeout": 5,
                        "input": {
                            "session": "${session_id}",
                            "event": "PostToolUse",
                            "runs_in": "claude_code",
                            "card_id": "${tool_input.card_id}"
                        }
                    }
                ]
            }
        ]
    }
}
