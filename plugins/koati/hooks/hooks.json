{
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "mcp_tool",
                        "server": "plugin:koati:koati",
                        "tool": "report_activity",
                        "timeout": 5,
                        "input": {
                            "session": "${session_id}",
                            "event": "UserPromptSubmit",
                            "runs_in": "claude_code"
                        }
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "mcp__plugin_koati_koati__get_handoff",
                "hooks": [
                    {
                        "type": "mcp_tool",
                        "server": "plugin:koati:koati",
                        "tool": "report_activity",
                        "timeout": 5,
                        "input": {
                            "session": "${session_id}",
                            "event": "PostToolUse",
                            "runs_in": "claude_code",
                            "card_id": "${tool_input.id}"
                        }
                    }
                ]
            },
            {
                "matcher": "mcp__plugin_koati_koati__(report_progress|ask_person|attach_artifact|upload_build|add_card_note)$",
                "hooks": [
                    {
                        "type": "mcp_tool",
                        "server": "plugin:koati:koati",
                        "tool": "report_activity",
                        "timeout": 5,
                        "input": {
                            "session": "${session_id}",
                            "event": "PostToolUse",
                            "runs_in": "claude_code",
                            "card_id": "${tool_input.card_id}"
                        }
                    }
                ]
            },
            {
                "matcher": "^(?!mcp__plugin_koati_koati__).*",
                "hooks": [
                    {
                        "type": "mcp_tool",
                        "server": "plugin:koati:koati",
                        "tool": "report_activity",
                        "timeout": 5,
                        "input": {
                            "session": "${session_id}",
                            "event": "PostToolUse",
                            "runs_in": "claude_code"
                        }
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "hooks": [
                    {
                        "type": "mcp_tool",
                        "server": "plugin:koati:koati",
                        "tool": "report_activity",
                        "timeout": 5,
                        "input": {
                            "session": "${session_id}",
                            "event": "PermissionRequest",
                            "runs_in": "claude_code"
                        }
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "mcp_tool",
                        "server": "plugin:koati:koati",
                        "tool": "report_activity",
                        "timeout": 5,
                        "input": {
                            "session": "${session_id}",
                            "event": "Stop",
                            "runs_in": "claude_code"
                        }
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "mcp_tool",
                        "server": "plugin:koati:koati",
                        "tool": "report_activity",
                        "timeout": 5,
                        "input": {
                            "session": "${session_id}",
                            "event": "SessionEnd",
                            "runs_in": "claude_code"
                        }
                    }
                ]
            }
        ]
    }
}
